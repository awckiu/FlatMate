GEMINI_API_KEY=
# Optional overrides. gemini-2.5-* is closed to new AI Studio projects.
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
# Tiger Data Postgres connection string. Leave empty to use the local index.
DATABASE_URL=

# Optional S3-compatible private storage for tenancy photos (leave all blank for local development).
PHOTO_STORAGE_ENDPOINT=
PHOTO_STORAGE_BUCKET=
PHOTO_STORAGE_ACCESS_KEY=
PHOTO_STORAGE_SECRET_KEY=
PHOTO_STORAGE_REGION=us-east-1

# Optional SMTP delivery for opted-in rent and bill reminders (sent two days before due date).
# Configure all required values to enable email reminders.
REMINDER_SMTP_HOST=
REMINDER_SMTP_PORT=587
REMINDER_SMTP_USERNAME=
REMINDER_SMTP_PASSWORD=
REMINDER_SMTP_USE_SSL=false
REMINDER_FROM_EMAIL=

# Only for scripts.copy_law: the main database to copy the law tables into.
MAIN_DATABASE_URL=
# Long random string that signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty means a new random one each run (everyone is logged out on restart).
SESSION_SECRET=
# true on the HTTPS server (Vultr), so the login cookie is only sent over HTTPS.
SESSION_HTTPS_ONLY=
